{
  "installMac": "curl -fsSL https://frely.cloud/start.sh | sh",
  "installLinux": "curl -fsSL https://frely.cloud/start.sh | sh",
  "installWindows": "curl.exe -fsSLo \"$env:TEMP\\frely-start.ps1\" https://frely.cloud/start.ps1; powershell -NoProfile -ExecutionPolicy Bypass -File \"$env:TEMP\\frely-start.ps1\"",
  "install": "npm install --global --ignore-scripts frely-cli@latest",
  "installBun": "bun add --global frely-cli@latest",
  "installPnpm": "pnpm add --global frely-cli@latest",
  "doctor": "frely doctor",
  "mcpSetup": "frely mcp start",
  "mcpUrl": "https://mcp.frely.cloud/mcp",
  "mcpJson": "{\n  \"mcpServers\": {\n    \"frely\": {\n      \"url\": \"https://mcp.frely.cloud/mcp\",\n      \"headers\": {\n        \"Authorization\": \"Bearer <token from the devices page>\"\n      },\n      \"disabled\": false\n    }\n  }\n}",
  "claudeConnect": "claude mcp add --transport http frelymcp \"https://mcp.frely.cloud/mcp\"",
  "codexConnect": "codex mcp add frelymcp --url \"https://mcp.frely.cloud/mcp\"",
  "installOnlyUnix": "curl -fsSL https://frely.cloud/install.sh | sh",
  "installOnlyWindows": "curl.exe -fsSLo \"$env:TEMP\\frely-install.ps1\" https://frely.cloud/install.ps1; powershell -NoProfile -ExecutionPolicy Bypass -File \"$env:TEMP\\frely-install.ps1\"",
  "login": "frely login --email <you@example.com>",
  "skillInstall": "frely skill install --host <claude-code|codex|pi|generic>"
}
