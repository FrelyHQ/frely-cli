{
  "install": "npm install --global --ignore-scripts frely-cli@latest",
  "login": "frely login",
  "doctor": "frely doctor",
  "mcpSetup": "frely mcp",
  "claudeConnect": "claude mcp add --transport http frely \"<MCP_URL>\"",
  "codexConnect": "codex mcp add frely --url \"<MCP_URL>\"",
  "codexAuthorize": "codex mcp login frely"
}
