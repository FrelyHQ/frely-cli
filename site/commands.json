{
  "installUnix": "curl -fsSL https://frely.cloud/install.sh | sh",
  "installWindows": "irm https://github.com/FrelyHQ/frely-cli/releases/latest/download/install.ps1 | iex",
  "install": "npm install --global --ignore-scripts frely-cli@latest",
  "login": "frely login",
  "doctor": "frely doctor",
  "mcpSetup": "frely mcp",
  "claudeConnect": "claude mcp add --transport http frely \"<MCP_URL>\"",
  "codexConnect": "codex mcp add frely --url \"<MCP_URL>\"",
  "codexAuthorize": "codex mcp login frely"
}
