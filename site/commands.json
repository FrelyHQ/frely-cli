{
  "installUnix": "curl -fsSL https://cli.frely.cloud/install.sh | sh",
  "installWindows": "irm https://cli.frely.cloud/install.ps1 | iex",
  "install": "npm install --global --ignore-scripts frely-cli@latest",
  "login": "frely login",
  "loginEmail": "frely login --email <EMAIL> --mcp",
  "loginCode": "frely login --code <CODE>",
  "doctor": "frely doctor",
  "mcpSetup": "frely mcp start",
  "claudeConnect": "claude mcp add --transport http frely \"https://mcp.frely.cloud/mcp\"",
  "codexConnect": "codex mcp add frely --url \"https://mcp.frely.cloud/mcp\"",
  "codexAuthorize": "codex mcp login frely"
}
