#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
wait_for_ci=1
args=()
while (($#)); do
  if [[ "$1" == "--no-wait" ]]; then
    wait_for_ci=0
    shift
  else
    args+=("$1")
    shift
  fi
done
echo "scripts/release-deploy is deprecated; use ./scripts/release" >&2
FRELY_RELEASE_WAIT_FOR_CI="$wait_for_ci" exec "$ROOT/scripts/release" "${args[@]}"
