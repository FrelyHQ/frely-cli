{
  "name": "frely-cli",
  "version": "0.6.10",
  "description": "Frely account CLI and local MCP runtime",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/FrelyHQ/frely-cli.git"
  },
  "homepage": "https://github.com/FrelyHQ/frely-cli#readme",
  "bugs": {
    "url": "https://github.com/FrelyHQ/frely-cli/issues"
  },
  "type": "module",
  "bin": {
    "frely": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "NOTICE",
    "TRADEMARKS.md",
    "skills"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs dist && tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/test.mjs",
    "start": "node dist/index.js",
    "release": "./scripts/release",
    "prepack": "npm run check && npm test && npm run build",
    "test:credentials": "node scripts/credential-smoke.mjs",
    "test:install": "node scripts/install-smoke.mjs",
    "build:standalone": "node scripts/build-standalone.mjs",
    "test:standalone": "node scripts/standalone-smoke.mjs",
    "test:installer": "node scripts/installer-smoke.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.2"
  }
}
