{
  "name": "frely-cli",
  "version": "0.3.6",
  "description": "Frely account CLI and local MCP runtime",
  "repository": {
    "type": "git",
    "url": "https://github.com/FrelyHQ/frely-cli.git"
  },
  "homepage": "https://github.com/FrelyHQ/frely-cli#readme",
  "bugs": {
    "url": "https://github.com/FrelyHQ/frely-cli/issues"
  },
  "type": "module",
  "bin": {
    "frely": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "rm -rf .test-dist && tsc -p tsconfig.test.json && node --test .test-dist/**/*.test.js && rm -rf .test-dist",
    "start": "node dist/index.js",
    "prepack": "npm run check && npm test && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.1",
    "keytar": "^7.9.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.2"
  },
  "allowScripts": {
    "keytar@7.9.0": true
  }
}
